{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gymtracker",
  "compatibility_date": "2026-09-04",

  // Static assets only. There is deliberately no `main` Worker script: this
  // application is a client-side SPA with no server component, and adding an
  // empty Worker would only create a second, unnecessary source of responses.
  //
  // It also keeps the security headers honest. Cloudflare applies the
  // `_headers` file to static asset responses but NOT to responses generated
  // by Worker code, so with no Worker code every response this site serves is
  // covered by the policy in dist/_headers.
  "assets": {
    "directory": "./dist",

    // Client-side routing: /history and /settings are React Router paths, not
    // files on disk, so an unmatched request has to fall back to index.html.
    "not_found_handling": "single-page-application",
  },

  // Cloudflare creates the DNS record for this hostname on first deploy.
  // It requires the zone to be active in the same account, and it refuses to
  // attach to a hostname that already has a CNAME record.
  "routes": [
    {
      "pattern": "gymtracker.kucera.uk",
      "custom_domain": true,
    },
  ],
}
