{
  "name": "gymtracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline calorie and macro tracker. All data stays in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:http": "node scripts/check-http.mjs",
    "check:barcode": "node scripts/check-barcode.mjs",
    "check:all": "npm run typecheck && npm run lint && npm run check:tokens && npm run check:contrast",
    "icons": "node scripts/generate-icons.mjs",
    "deploy": "npm run build && wrangler deploy",
    "publish:site": "npm run check:all && npm run deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "whoami": "wrangler whoami"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "dexie": "4.4.5",
    "dexie-react-hooks": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.3",
    "recharts": "3.10.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  }
}
